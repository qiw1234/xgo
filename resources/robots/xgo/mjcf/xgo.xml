    <motor name="bl_hip_motor" joint="bl_hip_joint" ctrlrange="-0.45 0.45" gear="1"/>
    <motor name="br_hip_motor" joint="br_hip_joint" ctrlrange="-0.45 0.45" gear="1"/>
    
    <!-- Thigh joint actuators -->
